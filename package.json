{
  "name": "devfleet",
  "version": "0.1.0",
  "description": "Start local microservices in dependency order, wait for health checks, and collect their logs in one place",
  "type": "module",
  "bin": {
    "devfleet": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "microservices",
    "msa",
    "spring-boot",
    "local-development",
    "process-manager",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
