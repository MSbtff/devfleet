{
  // Type checking only (src + test). The build uses tsconfig.build.json
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Only erasable syntax, so Node can run .ts directly (type stripping)
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    // Sources import './config.ts'; the build rewrites it to './config.js'
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
